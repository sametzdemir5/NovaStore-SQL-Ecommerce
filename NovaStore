-- ============================================================
-- BÖLÜM 3: SORGULAMA VE ANALİZ (DQL)
-- ============================================================

-- Bölüm 3 / Soru 1: Temel Listeleme
-- Stoğu 20'den az olan ürünler, stok miktarına göre azalan sırada
SELECT ProductName, Stock
FROM Products
WHERE Stock < 20
ORDER BY Stock DESC;
GO

-- Bölüm 3 / Soru 2: Veri Birleştirme (INNER JOIN)
-- Hangi müşteri, hangi tarihte sipariş vermiş?
SELECT c.FullName    AS [Müşteri Adı],
       c.City        AS [Şehir],
       o.OrderDate   AS [Sipariş Tarihi],
       o.TotalAmount AS [Toplam Tutar]
FROM Customers c
INNER JOIN Orders o ON c.CustomerID = o.CustomerID
ORDER BY o.OrderDate;
GO

-- Bölüm 3 / Soru 3: Çoklu Birleştirme ve Detay Raporu
-- "Ahmet Yılmaz" isimli müşterinin aldığı ürünler, fiyatları ve kategorileri
SELECT c.FullName     AS [Müşteri],
       p.ProductName  AS [Ürün Adı],
       p.Price        AS [Fiyat],
       cat.CategoryName AS [Kategori]
FROM Customers c
INNER JOIN Orders o         ON c.CustomerID = o.CustomerID
INNER JOIN OrderDetails od  ON o.OrderID    = od.OrderID
INNER JOIN Products p       ON od.ProductID = p.ProductID
INNER JOIN Categories cat   ON p.CategoryID = cat.CategoryID
WHERE c.FullName = N'Ahmet Yılmaz';
GO

-- Bölüm 3 / Soru 4: Gruplama ve Aggregate Fonksiyonlar
-- Hangi kategoride toplam kaç adet ürün var? (LEFT JOIN + GROUP BY + COUNT)
SELECT cat.CategoryName AS [Kategori],
       COUNT(p.ProductID) AS [Ürün Sayısı]
FROM Categories cat
LEFT JOIN Products p ON cat.CategoryID = p.CategoryID
GROUP BY cat.CategoryName
ORDER BY [Ürün Sayısı] DESC;
GO

-- Bölüm 3 / Soru 5: Ciro Analizi
-- Her müşterinin toplam cirosu, en çok harcayandan en aza doğru
SELECT c.FullName AS [Müşteri],
       SUM(o.TotalAmount) AS [Toplam Ciro]
FROM Customers c
INNER JOIN Orders o ON c.CustomerID = o.CustomerID
GROUP BY c.FullName
ORDER BY [Toplam Ciro] DESC;
GO

-- Bölüm 3 / Soru 6: Zaman Analizi
-- Siparişlerin üzerinden bugüne kadar kaç gün geçtiği
SELECT OrderID,
       OrderDate,
       DATEDIFF(DAY, OrderDate, GETDATE()) AS [Geçen Gün Sayısı]
FROM Orders
ORDER BY OrderDate;
GO


-- ============================================================
-- BÖLÜM 4: İLERİ SEVİYE VERİ TABANI NESNELERİ
-- ============================================================

-- Bölüm 4 / Görev 1: VIEW oluşturma
-- Müşteri Adı, Sipariş Tarihi, Ürün Adı ve Adet bilgisini tek tablo gibi getirir
CREATE VIEW vw_SiparisOzet
AS
SELECT c.FullName    AS MusteriAdi,
       o.OrderDate   AS SiparisTarihi,
       p.ProductName AS UrunAdi,
       od.Quantity   AS Adet
FROM Customers c
INNER JOIN Orders o        ON c.CustomerID = o.CustomerID
INNER JOIN OrderDetails od ON o.OrderID    = od.OrderID
INNER JOIN Products p      ON od.ProductID = p.ProductID;
GO

-- View'ı test etme
SELECT * FROM vw_SiparisOzet;
GO

